---
import Icon from './Icon.astro';
import { chatLink, hasWhatsApp } from '../site.config';

const link = chatLink();
---

{hasWhatsApp && (
  <a
    href={link.href}
    target="_blank"
    rel="noopener"
    aria-label="Chat with us on WhatsApp"
    class="fixed right-5 bottom-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-teal text-white shadow-[0_12px_28px_-10px_rgba(4,108,117,0.7)] transition-transform hover:scale-105"
  >
    <Icon name="chat" size={26} strokeWidth={2} />
  </a>
)}
