---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-line bg-cream px-6 py-12">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 text-center">
    <a href="#top" class="flex items-center gap-2.5 text-ink">
      <img src="/logo2.png" alt="" width="28" height="28" class="h-7 w-7" />
      <span class="font-headline text-lg font-bold">Newcomer</span>
    </a>
    <p class="m-0 max-w-md text-sm leading-relaxed text-muted">
      Immigration and document services for the international community in Argentina.
    </p>
    <p class="m-0 text-xs text-muted">© {currentYear} Newcomer. All rights reserved.</p>
    <p class="m-0 text-xs text-muted">
      Developed by{' '}
      <a
        class="underline hover:text-teal"
        href="https://www.onokaren.com"
        target="_blank"
        rel="noopener"
      >
        Ono
      </a>
    </p>
  </div>
</footer>
