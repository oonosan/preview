---
import Icon from './Icon.astro';
import ChatMock from './ChatMock.astro';
import { chatLink, site } from '../site.config';

const cta = chatLink();
const who = site.ownerName || 'one dedicated specialist';
---

<section
  id="top"
  class="mx-auto grid max-w-6xl items-center gap-14 px-6 pt-32 pb-20 md:pt-40 lg:grid-cols-[1.15fr_0.85fr]"
>
  <div class="fade-up flex flex-col gap-6">
    <span class="self-start rounded-full bg-mint-soft px-3.5 py-2 text-[13px] font-semibold text-teal-dark">
      Immigration &amp; documents · Buenos Aires
    </span>
    <h1 class="m-0 font-headline text-[2.5rem] leading-[1.07] font-extrabold tracking-[-0.035em] text-ink sm:text-5xl lg:text-[3.6rem]">
      Your new life in Argentina, without the paperwork{' '}
      <span class="hand-underline">
        headache.
        <svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true">
          <path
            d="M4 13 C 60 4, 140 4, 200 10 S 280 14, 296 7"
            fill="none"
            stroke="var(--color-terracotta-soft)"
            stroke-width="5"
            stroke-linecap="round"
          ></path>
        </svg>
      </span>
    </h1>
    <p class="m-0 max-w-xl text-lg leading-relaxed text-muted md:text-[19px]">
      Residencies, apostilles, DNI and every Argentine document — handled personally by {who}, who
      answers in English and walks you through each step. In Buenos Aires or from abroad.
    </p>
    <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap">
      <a
        href={cta.href}
        target={cta.external ? '_blank' : undefined}
        rel={cta.external ? 'noopener' : undefined}
        class="inline-flex items-center justify-center gap-2.5 rounded-full bg-terracotta px-7 py-4 text-base font-bold text-white shadow-[0_8px_18px_-10px_rgba(180,83,42,0.6)] transition-transform hover:-translate-y-0.5"
      >
        <Icon name="chat" size={20} strokeWidth={2} />
        Chat with us
      </a>
      <a
        href="#process"
        class="inline-flex items-center justify-center rounded-full border-[1.5px] border-ink px-6 py-[15px] text-base font-semibold text-ink transition-colors hover:bg-white"
      >
        See how it works
      </a>
    </div>
  </div>

  <ChatMock />
</section>
